# gha-indie-worker-api-server — every environment variable, with safe defaults.
#
# Copy to `.env` for local development. Real secrets live in `env/enc/*.env.enc`
# (ores-sops) and are decrypted at `docker run`, never at `docker build`.
# `.env` is gitignored; `.env.example` is the only dotenv in version control.
#
# Nothing here is required: with an empty environment the server binds
# 0.0.0.0:8080, serves /healthz, /metrics and /v1/capabilities, refuses every
# authenticated route with 401, and reports itself NOT ready on /readyz.

# ---- CLI surface (flags-2-env; read by the `ghaiw-api` client, not the server)
GHA_INDIE_WORKER_CONFIG=
GHA_INDIE_WORKER_API_BASE=
GHA_INDIE_WORKER_JSON=false

# ---- process ---------------------------------------------------------------
GHA_INDIE_WORKER_ENV=dev
GHA_INDIE_WORKER_API_BIND=0.0.0.0:8080
# Stateful length-prefixed JSON transport. Unset disables it.
GHA_INDIE_WORKER_API_TCP_BIND=
GHA_INDIE_WORKER_API_SHUTDOWN_GRACE_SECONDS=30
GHA_INDIE_WORKER_API_REQUEST_TIMEOUT_SECONDS=30
GHA_INDIE_WORKER_API_MAX_BODY_BYTES=1048576
RUST_LOG=info

# ---- database (SeaORM only; this service never runs DDL) -------------------
# Product servers get canonical + auth. Admin connection strings are not
# reachable from this process, and the firewall enforces that too.
DATABASE_URL_CANONICAL=
DATABASE_URL_AUTH=
GHA_INDIE_WORKER_DB_MAX_CONNECTIONS=10
GHA_INDIE_WORKER_DB_CONNECT_TIMEOUT_SECONDS=5

# ---- authentication --------------------------------------------------------
# shared-auth: all three travel together. The introspection secret needs at
# least 32 non-whitespace bytes.
SHARED_AUTH_BASE=
SHARED_AUTH_AUDIENCE=gha-indie-worker-api
SHARED_AUTH_INTROSPECT_SECRET=
# Supabase / Neon JWTs, the second half of dual auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
# Comma-separated. Empty means the claim is not pinned.
GHA_INDIE_WORKER_JWT_ISSUERS=
GHA_INDIE_WORKER_JWT_AUDIENCES=
GHA_INDIE_WORKER_JWKS_TTL_SECONDS=300

# ---- webhooks --------------------------------------------------------------
# GitHub X-Hub-Signature-256 HMAC secret; at least 32 non-whitespace bytes.
GHA_INDIE_WORKER_GITHUB_WEBHOOK_SECRET=
GHA_INDIE_WORKER_WEBHOOK_DELIVERY_TTL_SECONDS=3600
GHA_INDIE_WORKER_MAX_WEBHOOK_DELIVERIES=10000

# ---- NATS ------------------------------------------------------------------
# Subjects are giw.<env>.<domain>.<event>.
GHA_INDIE_WORKER_NATS_URL=
GHA_INDIE_WORKER_NATS_INTAKE_ENABLED=false

# ---- chat proxy ------------------------------------------------------------
ORES_CHAT_API_BASE=
ORES_CHAT_TIMEOUT_SECONDS=15

# ---- embeddings ------------------------------------------------------------
# Unset base = the deterministic local provider (development only; not semantic).
GHA_INDIE_WORKER_EMBEDDINGS_BASE=
GHA_INDIE_WORKER_EMBEDDINGS_API_KEY=
GHA_INDIE_WORKER_EMBEDDINGS_MODEL=text-embedding-3-small
GHA_INDIE_WORKER_EMBEDDINGS_DIMS=1536
GHA_INDIE_WORKER_EMBEDDINGS_TIMEOUT_SECONDS=30

# ---- rate limiting ---------------------------------------------------------
# Keys are opaque HMAC digests. A raw IP, email or token never reaches limiter
# state, a log line, or a backend keyspace.
GHA_INDIE_WORKER_RATE_LIMIT_HMAC_SECRET=
GHA_INDIE_WORKER_RATE_LIMIT_CAPACITY=120
GHA_INDIE_WORKER_RATE_LIMIT_WINDOW_SECONDS=60
# Read by ores-rl-lib-core's distributed authority when present.
REDIS_URL=

# ---- workers and websocket -------------------------------------------------
GHA_INDIE_WORKER_HEARTBEAT_TTL_SECONDS=90
GHA_INDIE_WORKER_WS_MAX_CONNECTIONS=1024
GHA_INDIE_WORKER_WS_CHANNEL_CAPACITY=256
GHA_INDIE_WORKER_WS_HEARTBEAT_SECONDS=20

# ---- ores-middleware -------------------------------------------------------
# Read by the middleware crate itself (ORES_MIDDLEWARE_*). Only the ones this
# service depends on are listed; see ores-middleware for the full surface.
ORES_MIDDLEWARE_RATE_LIMIT_HMAC_SECRET=

# ---- ores-sops -------------------------------------------------------------
# Supplied at `docker run`, never baked into an image layer.
SOPS_AGE_KEY=
SOPS_AGE_KEY_FILE=
SOPS_SECRETS_FILE=/app/secrets/app.env
