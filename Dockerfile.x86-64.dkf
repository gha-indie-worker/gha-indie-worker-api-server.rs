# GENERATED from Dockerfile (sha256:6b3d8ee5ed27950d) by ores-gha-workflows/scripts/render-dkf.mjs — target linux/amd64. Do not edit; edit Dockerfile and re-render.
# syntax=docker/dockerfile:1.7
#
# Multi-stage image for gha-indie-worker-api-server.
#
# Prefer linux/arm64 (Apple Silicon, Graviton, Hetzner ARM):
#   docker buildx build --platform linux/arm64 -t gha-indie-worker-api-server:dev .
#
# The per-architecture Dockerfile.arm64.dkf / Dockerfile.x86-64.dkf are rendered
# from this file by ores-gha-workflows' render-dkf.mjs. Edit this file only.
#
# ores-sops: https://github.com/ORESoftware/ores-sops
# Secrets are decrypted at `docker run`, never at `docker build`: a build-time
# decrypt writes plaintext into an immutable layer that ships with the image.

FROM --platform=linux/amd64 rust:1.88-slim-bookworm AS build
ARG TARGETARCH
WORKDIR /src

# Toolchain prerequisites only. Every TLS client here uses rustls, so there is
# no OpenSSL dependency to install or to keep patched.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        git \
        pkg-config \
    && apt-get clean \
    && find /var/lib/apt/lists -mindepth 1 -delete

COPY . .
RUN cargo build --release --bin gha-indie-worker-api-server \
    && strip target/release/gha-indie-worker-api-server

FROM --platform=linux/amd64 debian:bookworm-slim AS runtime
ARG SOPS_ENV=prod
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && apt-get clean \
    && find /var/lib/apt/lists -mindepth 1 -delete \
    && useradd --system --uid 65532 --no-create-home --shell /usr/sbin/nologin app

COPY --from=build /src/target/release/gha-indie-worker-api-server /usr/local/bin/gha-indie-worker-api-server
COPY --from=ghcr.io/getsops/sops:v3.10.2-alpine --chmod=0755 /usr/local/bin/sops /usr/local/bin/sops
COPY --chmod=0755 scripts/sops-entrypoint.sh /usr/local/bin/sops-entrypoint.sh

RUN --mount=type=bind,source=.,target=/src,ro \
    mkdir -p /app/secrets \
    && if [ -f "/src/env/enc/${SOPS_ENV}.env.enc" ]; then \
         cp "/src/env/enc/${SOPS_ENV}.env.enc" /app/secrets/app.env; \
       fi \
    && chown -R 65532:65532 /app /usr/local/bin/gha-indie-worker-api-server

ENV SOPS_SECRETS_FILE=/app/secrets/app.env \
    GHA_INDIE_WORKER_API_BIND=0.0.0.0:8080 \
    RUST_LOG=info

USER 65532:65532
EXPOSE 8080

# No HEALTHCHECK on purpose: the runtime image carries no HTTP client, and the
# orchestrator already probes GET /healthz (liveness, touches no dependency)
# and GET /readyz (readiness, fail-closed on the database and shared-auth).

ENTRYPOINT ["/usr/local/bin/sops-entrypoint.sh", "/usr/local/bin/gha-indie-worker-api-server"]
